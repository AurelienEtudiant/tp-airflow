# ============================================
# PostgreSQL - Airflow Metadata Database
# ============================================
POSTGRES_AIRFLOW_USER=airflow
POSTGRES_AIRFLOW_PASSWORD=change_me_airflow_password
POSTGRES_AIRFLOW_DB=airflow

# ============================================
# PostgreSQL - DWH (Data Warehouse)
# ============================================
POSTGRES_DWH_USER=dwh_user
POSTGRES_DWH_PASSWORD=change_me_dwh_password
POSTGRES_DWH_DB=dwh

# ============================================
# PostgreSQL - Source Database
# ============================================
POSTGRES_SOURCE_USER=source_user
POSTGRES_SOURCE_PASSWORD=change_me_source_password
POSTGRES_SOURCE_DB=source_db

# ============================================
# Redis (Celery Broker)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# MinIO
# ============================================
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=articles-bucket
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=change_me_minio_password

# ============================================
# Airflow Configuration
# ============================================
AIRFLOW_UID=1000
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__SQL_ALCHEMY_POOL_SIZE=20
AIRFLOW__CORE__SQL_ALCHEMY_MAX_OVERFLOW=40

AIRFLOW__API__SECRET_KEY=change_me_api_secret_key
AIRFLOW__API_AUTH__JWT_SECRET=change_me_jwt_secret_key
AIRFLOW__EXECUTION_API__JWT_AUDIENCE=urn:airflow.apache.org:task
AIRFLOW__API_AUTH__JWT_LEEWAY=30
AIRFLOW__WEBSERVER__SECRET_KEY=change_me_web_secret_key

# ============================================
# Airflow Connections
# ============================================
AIRFLOW_VAR_API_TOKEN=change_me_api_token
AIRFLOW_VAR_API_BASE_URL=http://api-simulee:5000

# ============================================
# API Simulée
# ============================================
API_TOKEN=change_me_api_token
API_PORT=5000

# ============================================
# Kafka Configuration
# ============================================
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_LOG_RETENTION_HOURS=168

# ============================================
# OpenSearch
# ============================================
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx1g
OPENSEARCH_CLUSTER_NAME=newsradar-cluster

# ============================================
# NLP Service
# ============================================
MODEL_SENTIMENT=distilbert-base-uncased-finetuned-sst-2-english
MODEL_CLASSIFY=facebook/bart-large-mnli
NLP_SERVICE_HOST=nlp-service
NLP_SERVICE_PORT=8000
