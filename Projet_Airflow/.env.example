# Copier vers .env : `copy .env.example .env` (Windows) ou `cp .env.example .env`
# Utilisé par les services Airflow (docker-compose.yml).

AIRFLOW_UID=50000

# Coexistence avec le LAB (dossier LAB/) : le LAB publie d'autres ports hote (18080 Airflow,
# 15432-15434 Postgres, 16379 Redis, 19000-19001 MinIO, 15000 API, 8001 NLP).
# Projet_Airflow garde 8080, 5432-5434, 6379, 9000-9001, 5001, 8000 — les deux peuvent tourner.
#
# NLP / MinIO : AIRFLOW_VAR_NEWSRADAR_* dans docker-compose.yml (bucket data-lake, prefix articles_*).
# Relancer les services Airflow apres modification :
#   docker compose up -d --force-recreate airflow-scheduler airflow-dag-processor airflow-worker airflow-apiserver
# Verification : docker compose ps   puis   .\scripts\verify-stack.ps1
# Si les DAGs restent en pause (base deja initialisee) : .\scripts\unpause-newsradar-chain.ps1
